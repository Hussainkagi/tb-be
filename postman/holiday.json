              "body": "{\n  \"success\": true,\n  \"message\": \"Holiday updated successfully\",\n  \"data\": {\n    \"id\": \"h1b2c3d4-0000-0000-0000-000000000003\",\n    \"company_id\": \"a1b2c3d4-0000-0000-0000-000000000001\",\n    \"branch_id\": null,\n    \"holiday_name\": \"UAE National Day\",\n    \"holiday_type\": \"national\",\n    \"holiday_start_date\": \"2025-12-02\",\n    \"holiday_end_date\": \"2025-12-02\",\n    \"is_company_wide\": true,\n    \"description\": \"Updated description\",\n    \"is_active\": true,\n    \"deleted_at\": null,\n    \"created_at\": \"2025-11-01T08:00:00.000Z\",\n    \"updated_at\": \"2025-11-10T10:30:00.000Z\"\n  }\n}"
