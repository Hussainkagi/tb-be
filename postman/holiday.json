    {
      "name": "3. Attendance & Payroll Helpers",
      "item": [
        {
          "name": "Check If Date Is Holiday",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/companies/{{company_id}}/holidays/branch/{{branch_id}}/check?date=2025-12-02",
              "host": ["{{base_url}}"],
              "path": [
                "api",
                "companies",
                "{{company_id}}",
                "holidays",
                "branch",
                "{{branch_id}}",
                "check"
              ],
              "query": [{ "key": "date", "value": "2025-12-02" }]
            }
          },
          "response": [
            {
              "name": "200 — Is a holiday",
              "status": "OK",
              "code": 200,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"is_holiday\": true,\n    \"date\": \"2025-12-02\",\n    \"branch_id\": \"b1b2c3d4-0000-0000-0000-000000000002\",\n    \"company_id\": \"a1b2c3d4-0000-0000-0000-000000000001\"\n  }\n}"
            },
            {
              "name": "200 — Not a holiday",
              "status": "OK",
              "code": 200,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"is_holiday\": false,\n    \"date\": \"2025-12-03\",\n    \"branch_id\": \"b1b2c3d4-0000-0000-0000-000000000002\",\n    \"company_id\": \"a1b2c3d4-0000-0000-0000-000000000001\"\n  }\n}"
            },
            {
              "name": "400 Missing date param",
              "status": "Bad Request",
              "code": 400,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"success\": false,\n  \"message\": \"Query param 'date' is required (YYYY-MM-DD)\"\n}"
            }
          ]
        },
        {
          "name": "Get Holidays By Date Range",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/companies/{{company_id}}/holidays/branch/{{branch_id}}/range?from=2025-12-01&to=2025-12-31",
              "host": ["{{base_url}}"],
              "path": [
                "api",
                "companies",
                "{{company_id}}",
                "holidays",
                "branch",
                "{{branch_id}}",
                "range"
              ],
              "query": [
                { "key": "from", "value": "2025-12-01" },
                { "key": "to", "value": "2025-12-31" }
              ]
            }
          },
          "response": [
            {
              "name": "200 Success",
              "status": "OK",
              "code": 200,
              "header": [
