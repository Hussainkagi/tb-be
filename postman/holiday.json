{
  "info": {
    "name": "HRMS — Holiday Module",
    "description": "All Holiday APIs. Set collection variables: base_url, token, company_id, branch_id, holiday_id.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:4000" },
    { "key": "token", "value": "your_jwt_token_here" },
    { "key": "company_id", "value": "a1b2c3d4-0000-0000-0000-000000000001" },
    { "key": "branch_id", "value": "b1b2c3d4-0000-0000-0000-000000000002" },
    { "key": "holiday_id", "value": "h1b2c3d4-0000-0000-0000-000000000003" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "1. Company-Wide Holidays",
      "item": [
        {
          "name": "Create Holiday (company-wide)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/companies/{{company_id}}/holidays",
              "host": ["{{base_url}}"],
              "path": ["api", "companies", "{{company_id}}", "holidays"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"holiday_name\": \"National Day\",\n  \"holiday_type\": \"national\",\n  \"holiday_start_date\": \"2025-12-02\",\n  \"holiday_end_date\": \"2025-12-02\",\n  \"is_company_wide\": true,\n  \"description\": \"UAE National Day — all branches closed\"\n}"
            }
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"success\": true,\n  \"message\": \"Holiday created successfully\",\n  \"data\": {\n    \"id\": \"h1b2c3d4-0000-0000-0000-000000000003\",\n    \"company_id\": \"a1b2c3d4-0000-0000-0000-000000000001\",\n    \"branch_id\": null,\n    \"holiday_name\": \"National Day\",\n    \"holiday_type\": \"national\",\n    \"holiday_start_date\": \"2025-12-02\",\n    \"holiday_end_date\": \"2025-12-02\",\n    \"is_company_wide\": true,\n    \"description\": \"UAE National Day — all branches closed\",\n    \"is_active\": true,\n    \"deleted_at\": null,\n    \"created_at\": \"2025-11-01T08:00:00.000Z\",\n    \"updated_at\": \"2025-11-01T08:00:00.000Z\"\n  }\n}"
            },
            {
              "name": "400 End date before start date",
              "status": "Bad Request",
              "code": 400,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"success\": false,\n  \"message\": \"holiday_end_date cannot be before holiday_start_date\"\n}"
            }
          ]
        },
        {
          "name": "Create Holiday (branch-specific)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/companies/{{company_id}}/holidays",
              "host": ["{{base_url}}"],
              "path": ["api", "companies", "{{company_id}}", "holidays"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"holiday_name\": \"Dubai Branch Foundation Day\",\n  \"holiday_type\": \"regional\",\n  \"holiday_start_date\": \"2025-10-15\",\n  \"holiday_end_date\": \"2025-10-15\",\n  \"is_company_wide\": false,\n  \"branch_id\": \"b1b2c3d4-0000-0000-0000-000000000002\",\n  \"description\": \"Dubai branch only\"\n}"
            }
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"success\": true,\n  \"message\": \"Holiday created successfully\",\n  \"data\": {\n    \"id\": \"h9b2c3d4-0000-0000-0000-000000000009\",\n    \"company_id\": \"a1b2c3d4-0000-0000-0000-000000000001\",\n    \"branch_id\": \"b1b2c3d4-0000-0000-0000-000000000002\",\n    \"holiday_name\": \"Dubai Branch Foundation Day\",\n    \"holiday_type\": \"regional\",\n    \"holiday_start_date\": \"2025-10-15\",\n    \"holiday_end_date\": \"2025-10-15\",\n    \"is_company_wide\": false,\n    \"description\": \"Dubai branch only\",\n    \"is_active\": true,\n    \"deleted_at\": null,\n    \"created_at\": \"2025-09-01T08:00:00.000Z\",\n    \"updated_at\": \"2025-09-01T08:00:00.000Z\"\n  }\n}"
            },
            {
              "name": "400 Missing branch_id",
              "status": "Bad Request",
              "code": 400,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"success\": false,\n  \"message\": \"branch_id is required when is_company_wide is false\"\n}"
            },
            {
              "name": "400 Branch not in company",
              "status": "Bad Request",
              "code": 400,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"success\": false,\n  \"message\": \"Branch does not belong to this company\"\n}"
            }
          ]
        },
