{
  "info": {
    "name": "HRMS-B API",
    "description": "Complete API documentation for HRMS multi-company platform. Covers auth, company registration, user management, employee invites, OTP verification, and company switching.",
    "_postman_id": "hrms-b-api-collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "company_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "department_id",
      "value": "33333333-3333-3333-3333-333333333333",
      "type": "string"
    },
    {
      "key": "branch_id",
      "value": "22222222-2222-2222-2222-222222222222",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Company",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"John\",\n  \"last_name\": \"Doe\",\n  \"email\": \"john@acme.com\",\n  \"phone\": \"+971501234567\",\n  \"password\": \"StrongPass@123\",\n  \"company_name\": \"Acme Corp\",\n  \"company_code\": \"ACME\",\n  \"company_email\": \"hr@acme.com\",\n  \"company_phone\": \"+97141234567\",\n  \"country\": \"UAE\",\n  \"timezone\": \"Asia/Dubai\",\n  \"currency\": \"AED\",\n  \"logo_url\": null\n}"
            },
            "description": "Registers a new company and creates an Admin user in one call. Sends OTP to email for verification."
          },
          "response": [
            {
              "name": "201 — Success",
              "status": "Created",
              "code": 201,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": true,\n  \"message\": \"Company registered. OTP sent to email for verification.\",\n  \"data\": {\n    \"user_id\": \"a1b2c3d4-0000-0000-0000-000000000001\",\n    \"company_id\": \"a1b2c3d4-0000-0000-0000-000000000002\",\n    \"username\": \"AC0001\",\n    \"was_existing_user\": false\n  }\n}"
            },
            {
              "name": "400 — Company code taken",
              "status": "Bad Request",
              "code": 400,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": false,\n  \"message\": \"Company code already taken\"\n}"
            },
            {
              "name": "400 — Weak password",
              "status": "Bad Request",
              "code": 400,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": false,\n  \"message\": \"Password must be at least 8 characters\"\n}"
            }
          ]
        },
        {
          "name": "Verify Email OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/verify-otp",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "verify-otp"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otp\": \"847291\",\n  \"user_id\": \"{{user_id}}\",\n  \"company_id\": \"{{company_id}}\"\n}"
            },
            "description": "Verifies the 6-digit OTP sent to email after company registration. OTP expires in 10 minutes."
          },
          "response": [
            {
              "name": "200 — Verified",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"Email verified successfully\"\n}"
            },
            {
              "name": "400 — Invalid / expired OTP",
              "status": "Bad Request",
              "code": 400,
              "body": "{\n  \"success\": false,\n  \"message\": \"Invalid or expired OTP\"\n}"
            }
          ]
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success) {",
                  "  pm.collectionVariables.set('access_token', res.data.access_token);",
                  "  pm.collectionVariables.set('user_id', res.data.user.user_id);",
                  "  pm.collectionVariables.set('company_id', res.data.user.company_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"AC0001\",\n  \"password\": \"StrongPass@123\"\n}"
            },
            "description": "Login using company-scoped username (e.g. AC0001) and password. Auto-saves access_token, user_id, company_id to collection variables."
          },
          "response": [
            {
              "name": "200 — Success",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"Login successful\",\n  \"data\": {\n    \"access_token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n    \"refresh_token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n    \"user\": {\n      \"user_id\": \"a1b2c3d4-0000-0000-0000-000000000001\",\n      \"username\": \"AC0001\",\n      \"first_name\": \"John\",\n      \"last_name\": \"Doe\",\n      \"email\": \"john@acme.com\",\n      \"role\": \"0\",\n      \"company_id\": \"a1b2c3d4-0000-0000-0000-000000000002\",\n      \"branch_id\": null\n    }\n  }\n}"
            },
            {
              "name": "401 — Invalid credentials",
              "status": "Unauthorized",
              "code": 401,
              "body": "{\n  \"success\": false,\n  \"message\": \"Invalid username or password\"\n}"
            },
            {
              "name": "401 — Account locked",
              "status": "Unauthorized",
              "code": 401,
              "body": "{\n  \"success\": false,\n  \"message\": \"Account locked due to too many failed attempts. Reset your password.\"\n}"
            },
            {
              "name": "401 — Password not set",
              "status": "Unauthorized",
              "code": 401,
              "body": "{\n  \"success\": false,\n  \"message\": \"Password not set. Please check your invite email.\"\n}"
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "description": "Clears the refresh token from DB. Requires valid JWT."
          },
          "response": [
            {
              "name": "200 — Success",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"Logged out successfully\"\n}"
            }
          ]
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/forgot-password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "forgot-password"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@acme.com\",\n  \"company_id\": \"{{company_id}}\"\n}"
            },
            "description": "Sends a password reset link to the user's email for the given company. Always returns 200 to prevent email enumeration."
          },
          "response": [
            {
              "name": "200 — Always (email enumeration safe)",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"If this account exists, a reset link has been sent\"\n}"
            }
          ]
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/reset-password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "reset-password"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"a3f9c2e1b4d7...\",\n  \"password\": \"NewStrongPass@456\"\n}"
            },
            "description": "Resets the password using the token from the reset email link. Token expires in 1 hour."
          },
          "response": [
            {
              "name": "200 — Success",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"Password reset successfully. You can now log in.\"\n}"
            },
            {
              "name": "400 — Invalid token",
              "status": "Bad Request",
              "code": 400,
              "body": "{\n  \"success\": false,\n  \"message\": \"Invalid or expired reset link\"\n}"
            }
          ]
        },
        {
          "name": "Set Password (Invite)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/set-password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "set-password"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"b7e3a1f2c9d4...\",\n  \"password\": \"MyFirstPass@789\"\n}"
            },
            "description": "Employee sets their password using the token from the invite email. Token expires in 48 hours."
          },
          "response": [
            {
              "name": "200 — Success",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"Password set successfully. You can now log in.\"\n}"
            },
            {
              "name": "400 — Invalid token",
              "status": "Bad Request",
              "code": 400,
              "body": "{\n  \"success\": false,\n  \"message\": \"Invalid or expired invite link\"\n}"
            },
            {
              "name": "400 — Already set",
              "status": "Bad Request",
              "code": 400,
              "body": "{\n  \"success\": false,\n  \"message\": \"Password already set for this company account\"\n}"
            }
          ]
        },
        {
          "name": "My Companies (Switcher List)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/my-companies",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "my-companies"
              ]
            },
            "description": "Returns all companies the logged-in user belongs to. Used to populate the company switcher UI."
          },
          "response": [
            {
              "name": "200 — Success",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"data\": [\n    {\n      \"id\": \"uc-uuid-001\",\n      \"user_id\": \"a1b2c3d4-0000-0000-0000-000000000001\",\n      \"company_id\": \"a1b2c3d4-0000-0000-0000-000000000002\",\n      \"username\": \"AC0001\",\n      \"role\": \"0\",\n      \"is_active\": true,\n      \"company_name\": \"Acme Corp\",\n      \"company_code\": \"ACME\",\n      \"logo_url\": null\n    },\n    {\n      \"id\": \"uc-uuid-002\",\n      \"user_id\": \"a1b2c3d4-0000-0000-0000-000000000001\",\n      \"company_id\": \"a1b2c3d4-0000-0000-0000-000000000003\",\n      \"username\": \"GL0001\",\n      \"role\": \"2\",\n      \"is_active\": true,\n      \"company_name\": \"Globex Ltd\",\n      \"company_code\": \"GLOB\",\n      \"logo_url\": \"https://cdn.example.com/globex.png\"\n    }\n  ]\n}"
            }
          ]
        },
        {
          "name": "Switch Company",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/switch-company",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "switch-company"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"company_id\": \"a1b2c3d4-0000-0000-0000-000000000003\"\n}"
            },
            "description": "Re-issues a new JWT scoped to the selected company. No re-login required. Use when user belongs to multiple companies."
          },
          "response": [
            {
              "name": "200 — Success",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"Switched company successfully\",\n  \"data\": {\n    \"access_token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n    \"refresh_token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n    \"company_id\": \"a1b2c3d4-0000-0000-0000-000000000003\",\n    \"company_name\": \"Globex Ltd\",\n    \"role\": \"2\"\n  }\n}"
            },
            {
              "name": "400 — Not a member",
              "status": "Bad Request",
              "code": 400,
              "body": "{\n  \"success\": false,\n  \"message\": \"User does not belong to this company\"\n}"
            }
          ]
        }
      ]
    },
