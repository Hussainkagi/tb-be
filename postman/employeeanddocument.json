              "raw": "{{base_url}}/companies/{{company_id}}/employees/{{employee_id}}/deactivate",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "companies",
                "{{company_id}}",
                "employees",
                "{{employee_id}}",
                "deactivate"
              ]
            },
            "description": "Deactivate an employee. If they were head of a department, that department loses its head automatically; when it still has employees the response carries `vacated_department` so the UI can prompt for a replacement."
          },
          "response": [
            {
              "name": "200 OK — was head of a department",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"Employee deactivated successfully\",\n  \"data\": {\n    \"id\": \"e1e2e3e4-0000-0000-0000-000000000001\",\n    \"is_active\": false,\n    \"updated_at\": \"2024-03-15T11:00:00.000Z\"\n  },\n  \"vacated_department\": {\n    \"department_id\": \"33333333-3333-3333-3333-333333333333\",\n    \"department_name\": \"Sales\",\n    \"employee_count\": 6,\n    \"message\": \"\\\"Sales\\\" no longer has a head. Assign a new head of department.\"\n  }\n}"
            },
            {
              "name": "200 OK — not a head",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"Employee deactivated successfully\",\n  \"data\": {\n    \"id\": \"e1e2e3e4-0000-0000-0000-000000000001\",\n    \"is_active\": false,\n    \"updated_at\": \"2024-03-15T11:00:00.000Z\"\n  },\n  \"vacated_department\": null\n}"
            }
          ]
        },
