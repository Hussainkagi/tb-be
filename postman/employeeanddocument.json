        {
          "name": "Update Employee",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/companies/{{company_id}}/employees/{{employee_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "companies",
                "{{company_id}}",
                "employees",
                "{{employee_id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+971509999999\",\n  \"address\": \"Villa 5, JVC, Dubai\",\n  \"department_id\": \"{{department_id}}\",\n  \"is_department_head\": true\n}"
            },
            "description": "Update an employee. Salary/bank fields are ignored here — use the salary-structure and bank-account endpoints.\n\nHEAD OF DEPARTMENT:\n- `is_department_head: true` promotes this employee to head of their department; the outcome comes back in `department_head_result` (it fails there, without failing the update, if the department already has a head).\n- Moving the employee to a different `department_id` automatically clears the head of the department they were heading. When that department still has employees the response carries `vacated_department` — prompt the admin to assign a new head."
          },
          "response": [
            {
              "name": "200 OK — promoted to head",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"Employee updated successfully\",\n  \"data\": {\n    \"id\": \"e1e2e3e4-0000-0000-0000-000000000001\",\n    \"phone\": \"+971509999999\",\n    \"address\": \"Villa 5, JVC, Dubai\",\n    \"department_id\": \"33333333-3333-3333-3333-333333333333\",\n    \"updated_at\": \"2024-03-15T10:30:00.000Z\"\n  },\n  \"vacated_department\": null,\n  \"department_head_result\": {\n    \"success\": true,\n    \"message\": \"Head of department assigned successfully\",\n    \"data\": {\n      \"id\": \"33333333-3333-3333-3333-333333333333\",\n      \"department_name\": \"Engineering\",\n      \"head_employee_id\": \"e1e2e3e4-0000-0000-0000-000000000001\",\n      \"employee_count\": 7\n    }\n  }\n}"
            },
            {
              "name": "200 OK — moved out of a department they headed",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"Employee updated successfully\",\n  \"data\": {\n    \"id\": \"e1e2e3e4-0000-0000-0000-000000000001\",\n    \"department_id\": \"33333333-3333-3333-3333-333333333334\",\n    \"updated_at\": \"2024-03-15T10:30:00.000Z\"\n  },\n  \"vacated_department\": {\n    \"department_id\": \"33333333-3333-3333-3333-333333333333\",\n    \"department_name\": \"Sales\",\n    \"employee_count\": 6,\n    \"message\": \"\\\"Sales\\\" no longer has a head. Assign a new head of department.\"\n  },\n  \"department_head_result\": null\n}"
            },
            {
              "name": "200 OK — promotion rejected (department already has a head)",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"Employee updated successfully\",\n  \"data\": {\n    \"id\": \"e1e2e3e4-0000-0000-0000-000000000001\",\n    \"updated_at\": \"2024-03-15T10:30:00.000Z\"\n  },\n  \"vacated_department\": null,\n  \"department_head_result\": {\n    \"success\": false,\n    \"message\": \"This department already has a head. Pass replace: true to change it.\",\n    \"data\": {\n      \"current_head_employee_id\": \"55555555-5555-5555-5555-555555555555\",\n      \"current_head_name\": \"Ravi Kumar\"\n    }\n  }\n}"
            },
            {
              "name": "404 Not Found",
              "status": "Not Found",
              "code": 404,
              "body": "{\n  \"success\": false,\n  \"message\": \"Employee not found\"\n}"
            }
