# ─────────────────────────────────────────────────────────────
# hrms-backend — environment template
# Copy to .env and fill in. Never commit the real .env.
# ─────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
ALLOWED_ORIGINS=http://localhost:3000

# ── Background jobs ──────────────────────────────────────────
# Whether THIS process runs the cron jobs (attendance reminders,
# the per-minute notification dispatch queue, birthday wishes,
# task deadline sweep, task performance rollup).
#
# Leave false on every API instance: the API is scaled horizontally,
# and each instance registering the same schedules would fire them
# N times — duplicate pushes, duplicate rollups, racing writes.
#
# Exactly ONE process should run with RUN_JOBS=true (the `worker`
# service in docker-compose.yml). If nothing does, scheduled
# notifications are never delivered.
RUN_JOBS=false

# ── Database ─────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hrms_db
DB_USER=postgres
DB_PASSWORD=

# ── Auth ─────────────────────────────────────────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── Frontend ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Email (Resend) ───────────────────────────────────────────
RESEND_API_KEY=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# ── Media (Cloudinary) ───────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Push notifications (Firebase) ────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
